# Copia este archivo como `.env.local` y pega tus valores de:
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://TU-REF.supabase.co
# Puede ser la clave "anon" (JWT eyJ...) o la nueva publishable (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA
# Opcional: bucket de Storage para fotos (default productos-fotos). Debe existir en Supabase → Storage.
# VITE_SUPABASE_STORAGE_BUCKET=productos-fotos
#
# En desarrollo, Vite proxifica /functions/v1 → tu proyecto (VITE_SUPABASE_URL en esta carpeta).
# Así las Edge Functions no chocan con CORS en localhost.
# Para desactivar y llamar directo a *.supabase.co (solo si el gateway permite OPTIONS):
# VITE_SUPABASE_DISABLE_FUNCTIONS_PROXY=1
#
# --- Cloudflare R2 (archivos grandes de Bodega) ---
# Activa subida/descarga vía Edge Function bodega-r2-storage (ver supabase/R2_STORAGE_SETUP.md).
# VITE_USE_R2_STORAGE=1
# Sin R2, el límite de 50 MB por archivo en Supabase Free sigue aplicando en el navegador.
# VITE_BODEGA_SKIP_UPLOAD_SIZE_CAP=1
# VITE_BODEGA_MAX_STORAGE_UPLOAD_MB=500
#
# --- Scripts CLI (solo en tu PC, no en el build web) ---
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Para scripts/migrate-bodega-archivos.mjs (nunca subir a git)
